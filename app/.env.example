APP_NAME=LaravelTodoList
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Configurazione Database per Docker
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=

# Configurazione del Logging e dei Driver di Sessione
LOG_CHANNEL=stack
LOG_STACK=single

BROADCAST_CONNECTION=log
CACHE_CONNECTION=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120